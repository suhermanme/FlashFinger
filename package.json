{
  "name": "flashfinger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, cross-platform typing trainer",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "electron:compile": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/electron',{recursive:true});fs.writeFileSync('dist/electron/package.json',JSON.stringify({type:'commonjs'}))\"",
    "electron:dev": "npm run build && npm run electron:compile && electron dist/electron/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
